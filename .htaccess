# MANDAT System - Apache Configuration
# Updated with Administrasi Routes
# Developed by: BPS Kabupaten Boven Digoel (Galih Pramono)
# Year: 2025

# Enable Rewrite Engine
RewriteEngine On

# Set Base Directory (sesuaikan dengan folder instalasi)
RewriteBase /repmandat/

# Redirect HTTP to HTTPS (opsional, uncomment jika sudah pakai SSL)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ====================================================
# ✅ ROUTES KHUSUS ADMINISTRASI - DITAMBAHKAN SEBELUM CATCH-ALL
# ====================================================

# Jika file atau folder nyata ada, langsung akses
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# ✅ FORM INPUT ADMINISTRASI
RewriteRule ^administrasi/form/?$ index.php?controller=administrasi&action=form [QSA,L]

# ✅ API ROUTES
RewriteRule ^administrasi/save-perjalanan/?$ index.php?controller=administrasi&action=savePerjalanan [QSA,L]
RewriteRule ^administrasi/save-honorarium/?$ index.php?controller=administrasi&action=saveHonorarium [QSA,L]
RewriteRule ^administrasi/get-files/?$ index.php?controller=administrasi&action=getFiles [QSA,L]
RewriteRule ^administrasi/kirim-verifikasi/?$ index.php?controller=administrasi&action=kirimVerifikasi [QSA,L]

# ✅ VERIFIKASI ACTION ROUTES (AJAX endpoints — view-less)
RewriteRule ^administrasi/approve-verifikasi-kepala/?$ index.php?controller=administrasi&action=approveVerifikasiKepala [QSA,L]
RewriteRule ^administrasi/approve-verifikasi-ppk/?$ index.php?controller=administrasi&action=approveVerifikasiPPK [QSA,L]
RewriteRule ^administrasi/approve-verifikasi-bendahara/?$ index.php?controller=administrasi&action=approveVerifikasiBendahara [QSA,L]

# ====================================================
# ✅ ROUTES EXISTING ADMINISTRASI
# ====================================================

# Jika file atau folder nyata ada, langsung akses
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

RewriteRule ^administrasi/?$ index.php?controller=administrasi&action=index [QSA,L]
RewriteRule ^administrasi/delete/([0-9]+)/?$ index.php?controller=administrasi&action=delete&id=$1 [QSA,L]
RewriteRule ^administrasi/delete-file/([0-9]+)/?$ index.php?controller=administrasi&action=deleteFile&id=$1 [QSA,L]
RewriteRule ^administrasi/download-file/([0-9]+)/?$ index.php?controller=administrasi&action=downloadFile&id=$1 [QSA,L]
RewriteRule ^administrasi/export/?$ index.php?controller=administrasi&action=export [QSA,L]

# ====================================================
# ✅ ROUTES DOKUMEN (Surat Tugas + SPD, SPK SNLIK, BAST Honor Kegiatan)
# ====================================================

# Jika file atau folder nyata ada, langsung akses
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Alias URL "cantik" → action camelCase di DokumenController
RewriteRule ^dokumen/surat-tugas-spd/?$   index.php?controller=dokumen&action=generateSuratTugasSPD [QSA,L]
RewriteRule ^dokumen/spk-snlik/?$         index.php?controller=dokumen&action=generateSPKSnlik [QSA,L]
RewriteRule ^dokumen/bast-kegiatan/?$     index.php?controller=dokumen&action=generateBASTKegiatan [QSA,L]
RewriteRule ^dokumen/bast-kegiatan/([0-9]+)/?$ index.php?controller=dokumen&action=generateBASTKegiatan&kegiatan_detail_id=$1 [QSA,L]

# ====================================================
# ✅ CATCH-ALL ROUTE UNTUK SEMUA URL LAINNYA
# ====================================================

# Jika file atau folder nyata ada, langsung akses
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Parse URL: /controller/action/id → controller=controller&action=action&id=id
RewriteRule ^([a-zA-Z0-9_-]+)/?$ index.php?controller=$1&action=index [QSA,L]
RewriteRule ^([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ index.php?controller=$1&action=$2 [QSA,L]
RewriteRule ^([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/([0-9]+)/?$ index.php?controller=$1&action=$2&id=$3 [QSA,L]

# ====================================================
# ✅ KONFIGURASI KEAMANAN & PERFORMANCE (TIDAK BERUBAH)
# ====================================================

# Prevent directory browsing
Options -Indexes

# Protect sensitive files
<FilesMatch "\.(env|sql|json|lock|md)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Enable GZIP Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript
</IfModule>

# Set Cache Control
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # XSS Protection
    Header always set X-XSS-Protection "1; mode=block"
    
    # Prevent MIME sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# PHP Settings (optional)
<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 20M
    php_value max_execution_time 300
    php_value memory_limit 256M
</IfModule>

# Error Pages (uncomment untuk custom error pages)
# ErrorDocument 404 /error/404.php
# ErrorDocument 403 /error/403.php
# ErrorDocument 500 /error/500.php